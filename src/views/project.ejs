<%- include('partials/header') %>
    <main>
        <h1>
            <%= title %>
        </h1>

        <h2>
            <%= projectDetails.title %>
        </h2>

        <p>
            <%= projectDetails.description %>
        </p>

        <p><strong>Date:</strong>
            <%= projectDetails.date %>
        </p>

        <p><strong>Location:</strong>
            <%= projectDetails.location %>
        </p>

        <p>
            <strong>Organization:</strong>
            <a href="/organization/<%= projectDetails.organization_id %>">
                <%= projectDetails.organization_name %>
            </a>
        </p>
        <h3>Categories</h3>
        <ul>
            <% if (categories && categories.length> 0) { %>
                <% categories.forEach(category=> { %>
                    <li>
                        <a href="/category/<%= category.category_id %>">
                            <%= category.name %>
                        </a>
                    </li>
                    <% }) %>
                        <% } else { %>
                            <li>No categories assigned.</li>
                            <% } %>
        </ul>

        <% if (user) { %>
            <section class="volunteer-section">
                <% if (isVolunteering) { %>
                    <p><strong>You are volunteering for this project.</strong></p>

                    <form action="/project/<%= projectDetails.project_id %>/remove-volunteer" method="POST">
                        <button type="submit">Remove me as volunteer</button>
                    </form>
                    <% } else { %>
                        <form action="/project/<%= projectDetails.project_id %>/volunteer" method="POST">
                            <button type="submit">Volunteer for this project</button>
                        </form>
                        <% } %>
            </section>
            <% } %>

                <% if (user && user.role_name==='admin' ) { %>
                    <a href="/assign-categories/<%= projectDetails.project_id %>">Edit Categories</a><br>
                    <a href="/edit-project/<%= projectDetails.project_id %>">Edit Project</a>
                    <% } %>
    </main>
    <%- include('partials/footer') %>