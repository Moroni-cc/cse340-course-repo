<%- include('partials/header') %>
    <main>
        <h1>
            <%= title %>
        </h1>

        <h2>
            <%= categoryDetails.name %>
        </h2>

        <h3>Service Projects</h3>
        <ul>
            <% if (projects && projects.length> 0) { %>
                <% projects.forEach(project=> { %>
                    <li>
                        <a href="/project/<%= project.project_id %>">
                            <%= project.title %>
                        </a>
                        —
                        <a href="/organization/<%= project.organization_id %>">
                            <%= project.organization_name %>
                        </a>
                    </li>
                    <% }) %>
                        <% } else { %>
                            <li>No projects for this category.</li>
                            <% } %>
        </ul>
        <a href="/edit-category/<%= categoryDetails.category_id %>">Edit Category</a>
    </main>
    <%- include('partials/footer') %>