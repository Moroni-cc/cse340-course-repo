<%- include('partials/header') %>
    <main>
        <h1>
            <%= title %>
        </h1>

        <table>
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Role</th>
                    <th>Member Since</th>
                </tr>
            </thead>
            <tbody>
                <% users.forEach(user=> { %>
                    <tr>
                        <td>
                            <%= user.name %>
                        </td>
                        <td>
                            <%= user.email %>
                        </td>
                        <td>
                            <%= user.role_name %>
                        </td>
                        <td>
                            <%= new Date(user.created_at).toLocaleDateString() %>
                        </td>
                    </tr>
                    <% }); %>
            </tbody>
        </table>

    </main>
    <%- include('partials/footer') %>