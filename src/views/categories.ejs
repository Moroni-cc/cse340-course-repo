<%- include('partials/header') %>
    <main>
        <h1>
            <%= title %>
        </h1>
        <h2>Available Categories</h2>
        <p>Browse our projects by their service category:</p>
        <ul>
            <% if (categories && categories.length> 0) { %>
                <% categories.forEach(category=> { %>
                    <li>
                        <strong>
                            <a href="/category/<%= category.category_id %>">
                                <%= category.name %>
                            </a>
                        </strong>
                    </li>
                    <% }) %>
                        <% } else { %>
                            <li>No categories available at this time.</li>
                            <% } %>
        </ul>
        <a href="/new-category">Add New Category</a>
    </main>
    <%- include('partials/footer') %>