<%- include('partials/header') %>
    <main>
        <h1>
            <%= title %>
        </h1>
        <h2>Upcoming Service Projects</h2>

        <ul>
            <% if (projects && projects.length> 0) { %>
                <% projects.forEach(project=> { %>
                    <li>
                        <strong>
                            <%= new Date(project.date).toLocaleDateString('en-US', { day: '2-digit' , month: 'long' ,
                                year: 'numeric' }) %>:
                        </strong>
                        <%= project.title %>
                            <em>(<%= project.organization_name %>)</em>
                            <p>
                                <%= project.description %>
                            </p>
                            <p><small>📍 Location: <%= project.location %></small></p>
                    </li>
                    <hr>
                    <% }) %>
                        <% } else { %>
                            <li>No projects available at this time.</li>
                            <% } %>
        </ul>
    </main>
    <%- include('partials/footer') %>