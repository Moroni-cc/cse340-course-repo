<%- include('partials/header') %>
    <main>
        <h1>
            <%= title %>
        </h1>

        <h2>
            <%= projectDetails.title %>
        </h2>

        <p>
            <%= projectDetails.description %>
        </p>

        <p><strong>Date:</strong>
            <%= projectDetails.date %>
        </p>

        <p><strong>Location:</strong>
            <%= projectDetails.location %>
        </p>

        <p>
            <strong>Organization:</strong>
            <a href="/organization/<%= projectDetails.organization_id %>">
                <%= projectDetails.organization_name %>
            </a>
        </p>
        <h3>Categories</h3>
        <ul>
            <% if (categories && categories.length> 0) { %>
                <% categories.forEach(category=> { %>
                    <li>
                        <a href="/category/<%= category.category_id %>">
                            <%= category.name %>
                        </a>
                    </li>
                    <% }) %>
                        <% } else { %>
                            <li>No categories assigned.</li>
                            <% } %>
        </ul>
        <a href="/assign-categories/<%= projectDetails.project_id %>">Edit Categories</a>
    </main>
    <%- include('partials/footer') %>